{
  "name": "japanese-study-app",
  "private": true,
  "version": "0.1.0",
  "description": "Study Japanese vocabulary from a text you are reading: flashcards with stroke-order diagrams and example sentences.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "copy-dict": "node scripts/copy-dict.mjs",
    "build-dict": "node scripts/build-dict.mjs",
    "predev": "npm run copy-dict && npm run build-dict",
    "dev": "vite",
    "prebuild": "npm run copy-dict && npm run build-dict",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen-tatoeba-types": "node scripts/gen-tatoeba-types.mjs"
  },
  "dependencies": {
    "@patdx/kuromoji": "^1.0.4",
    "idb": "^8.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
